{
    "name": "notes-app-backend",
    "version": "1.0.0",
    "description": "Backend foundation for the Notes App",
    "main": "dist/server.js",
    "type": "commonjs",
    "scripts": {
        "dev": "tsx watch src/server.ts",
        "build": "tsc -p tsconfig.json",
        "start": "node dist/server.js",
        "typecheck": "tsc --noEmit -p tsconfig.json"
    },
    "dependencies": {
        "bcryptjs": "^3.0.3",
        "cors": "^2.8.5",
        "dotenv": "^16.4.5",
        "express": "^4.21.2",
        "helmet": "^8.0.1",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^8.6.3",
        "pino": "^9.1.0"
    },
    "devDependencies": {
        "@types/bcryptjs": "^2.4.6",
        "@types/cors": "^2.8.19",
        "@types/express": "^4.17.21",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^22.15.18",
        "pino-pretty": "^13.0.0",
        "tsx": "^4.19.4",
        "typescript": "^5.8.3"
    }
}
